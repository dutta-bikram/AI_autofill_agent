# AI Autofill Agent Configuration

# LLM Provider: 'openai', 'gemini', 'ollama', or 'mock' (offline demo mode)
LLM_PROVIDER=gemini

# API Keys (optional if using 'mock' or local 'ollama')
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Models
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# Browser Automation Settings
HEADLESS_BROWSER=false
BROWSER_SLOW_MO=300
HIGHLIGHT_ELEMENTS=true

# Human-In-The-Loop (HITL) Mode: 'always', 'low_confidence', or 'never'
HITL_MODE=always
CONFIDENCE_THRESHOLD=0.85

# Storage & RAG paths
CHROMA_PERSIST_DIR=./data/chroma_db
USER_PROFILE_PATH=./data/user_profile.json
DOCUMENTS_DIR=./data/documents

# Server Port
SERVER_PORT=8000
SERVER_HOST=127.0.0.1
